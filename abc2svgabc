#!/bin/sh
##################################################################################
#
# Process an ABC file with abc2svg toabc.js, after processing its includes.
# Useful when the source file contains conditional statements.
#
#   abc2svgabc <abc_src_file> <abc_dst_file> [<options>]
#
# <abc_dst_file> is relative to the current directory.
#
# Frédéric Boulanger                     frederic.softdev@gmail.com
#
##################################################################################
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
STUFFDIR=$(cd "$(dirname "$self")" && pwd)
. "$STUFFDIR/abc2svgstuff.sh"

if [ $# -lt 2 ]
then
  echo "# Usage: $PROG <abc_file> <dst_abc_file> [<options>]"
  exit 1
fi
output=$(abspath "$2")
abc_source "$1"
shift 2
make_tmpdir
abc_flatten "$SRC" "$TMPD/s/$SRC"
abc2svg_run toabc.js "$@" "$TMPD/s/$SRC" > "$TMPD/out.abc" || die "abc2svg failed on $SRC"
cp "$TMPD/out.abc" "$output"
