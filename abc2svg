#!/bin/sh
##################################################################################
#
# A wrapper to run abc2svg with node (abcnode) wherever abc2svg is installed.
#
#   abc2svg [<script.js>] [<options>] <abc_file> ...
#
# Frédéric Boulanger                     frederic.softdev@gmail.com
#
##################################################################################
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
STUFFDIR=$(cd "$(dirname "$self")" && pwd)
. "$STUFFDIR/abc2svgstuff.sh"

abc2svg_run "$@"
