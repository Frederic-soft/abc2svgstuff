#!/bin/sh
##################################################################################
#
# A wrapper to run the abctopdf script of abc2svg wherever abc2svg is installed
# (see abc2svg).
#
#   abctopdf [<options>] <abc_file> -o <pdf_file>
#
# Frédéric Boulanger                     frederic.softdev@gmail.com
#
##################################################################################
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
STUFFDIR=$(cd "$(dirname "$self")" && pwd)
. "$STUFFDIR/abc2svgstuff.sh"

abc2svg_topdf "$@"
