#!/bin/sh
##################################################################################
#
# Convert an ABC file into MusicXML files, using abc2svg and abc2xml. A MusicXML
# file is produced for each tune in the ABC file, the names are obtained by
# suffixing the ABC file name with an underscore followed by the index of the
# tune in the file (from 1, regardless of the X: fields).
#
#   abc2svgxml <abc_file> [-o <xml_file_base>] [-s <ss-pref_chars>] [-real_sound <0|1>]
#
# By default, the MusicXML files are written next to the ABC file. An explicit
# <xml_file_base> is relative to the current directory.
#
# Environment: ABC2XML  abc2xml command (default: abc2xml)
#
# Frédéric Boulanger                     frederic.softdev@gmail.com
#
##################################################################################
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
STUFFDIR=$(cd "$(dirname "$self")" && pwd)
. "$STUFFDIR/abc2svgstuff.sh"

usage() {
  echo "# Usage: $PROG <abc_file> [-o <xml_file_base>] [-s <ss-pref_chars>] [-real_sound <0|1>]"
  echo "#        Converts an ABC music file into as many MusicXML files as there are tunes in it."
  echo "#        <xml_file_base> is the optional base name of the generated files."
  exit 1
}

[ $# -ge 1 ] || usage
ABC2XML=${ABC2XML:-abc2xml}
command -v "$ABC2XML" >/dev/null 2>&1 || die "$ABC2XML not found"
src=$1
shift
xml_base=
sspref="%"
realsound="0"
while [ $# -ge 2 ]
do
  case $1 in
    -o) xml_base=$(abspath "$2") ;;
    -s) sspref=$2 ;;
    -real_sound) realsound=$2 ;;
    *) echo "# Unrecognized option: $1 $2" ; usage ;;
  esac
  shift 2
done
[ $# -eq 0 ] || { echo "# Incomplete or unrecognized option: $1" ; usage ; }

abc_source "$src"
[ -n "$xml_base" ] || xml_base=$SRC_DIR/$SRC_NAME
mkdir -p "$(dirname "$xml_base")" || die "cannot create the directory of $xml_base"
make_tmpdir
abc_flatten "$SRC" "$TMPD/flat.abc"
# Escape \n as \\\\n so that abc2svg toabc.js does not expand it, remove text blocks
sed -e 's/\\n/\\\\\\\\n/g' "$TMPD/flat.abc" | sh "$STUFFDIR/abcrmtext" > "$TMPD/all.abc"
ntunes=$(abc_tune_count "$TMPD/all.abc")
[ "$ntunes" -gt 0 ] || die "no tune (X: field) in $SRC"
idx=1
while [ "$idx" -le "$ntunes" ]
do
  x=$(abc_tune_x "$TMPD/all.abc" "$idx")
  echo "Processing tune X:${x}/${idx}"
  abc_tune "$TMPD/all.abc" "$idx" > "$TMPD/s/$SRC"
  abc2svg_run toabc.js --ss-pref "$sspref" --sounding-score "$realsound" "$TMPD/s/$SRC" \
    > "$TMPD/toabc.abc" </dev/null || die "abc2svg failed on tune X:${x}"
  sed -e 's/^%%linebreak \$$/%%linebreak <EOL>/' \
      -e 's/I:linebreak \$$/I:linebreak <EOL>/' \
      -e 's/\$$//' \
      -e '/^$/d' "$TMPD/toabc.abc" > "$TMPD/s/${SRC_NAME}_${idx}.abc"
  "$ABC2XML" "$TMPD/s/${SRC_NAME}_${idx}.abc" > "$TMPD/out.musicxml" </dev/null \
    || die "abc2xml failed on tune X:${x}"
  cp "$TMPD/out.musicxml" "${xml_base}_${idx}.musicxml" || die "cannot write ${xml_base}_${idx}.musicxml"
  idx=$((idx + 1))
done
