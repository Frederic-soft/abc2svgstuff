#!/bin/sh
##################################################################################
#
# Convert an ABC file into an HTML file with dynamic rendering and playback
# of the score, using abc2svg. The includes are processed, and $d is replaced
# by the date of the most recent file in %%header and %%footer lines.
#
#   abc2svgweb <abc_file> [-d] [-f] [-o <html_file>] [-u <abc2svg_script_url>]
#                         [-j "<abc2svg_scripts>"] [-s <ss-pref_chars>]
#
# By default, the HTML file is written next to the ABC file. An explicit
# <html_file> is relative to the current directory.
#
# The page loads the abc2svg scripts from <abc2svg_script_url>, which defaults
# to $ABC2SVG_JSURL, or to the scripts published by the author of abc2svg
# (http://moinejf.free.fr/js). To use a local installation, give for instance
# -u ../abc2svg or -u file:///usr/local/abc2svg (the URL is resolved by the
# browser, relative to the HTML file).
#
# Environment: ABC2SVG_JSURL  default URL of the abc2svg scripts
#
# Frédéric Boulanger                     frederic.softdev@gmail.com
#
##################################################################################
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
STUFFDIR=$(cd "$(dirname "$self")" && pwd)
. "$STUFFDIR/abc2svgstuff.sh"

## URL of the abc2svg files
# abc2svgurl="file:///usr/local/lib/node_modules/abc2svg"
# abc2svgurl="file:///usr/local/ABC/abc2svg"
# abc2svgurl="../abc2svg"
abc2svgurl=${ABC2SVG_JSURL:-http://moinejf.free.fr/js}

## Scripts to include in the header
# abc2svgscripts="abc2svg-1.js abcemb-1.js play-1.js follow-1.js"
# abc2svgscripts="abc2svg-1.js abcweb2-1.js snd-1.js follow-1.js"
# abc2svgscripts="abcweb-1.js snd-1.js follow-1.js"
abc2svgscripts="abcweb-1.js snd-1.js"

## Default characters for format lines
sspref="%"

usage() {
  echo "# Usage: $PROG <abc_file> [-d] [-f] [-o <html_file>] [-u <abc2svg_script_url>]"
  echo "#                         [-j \"<abc2svg_scripts>\"] [-s <ss-pref_chars>]"
  echo "#        Converts an ABC music file into a web page, with MIDI rendering"
  echo "#        and refering to individual abc2svg script from the given URL."
  exit 1
}

[ $# -ge 1 ] || usage
src=$1
shift
outfile=
debug=0
final=0
while getopts "dfo:u:j:s:" opt
do
  case $opt in
    d) debug=1 ;;
    f) final=1 ;;
    o) outfile=$(abspath "$OPTARG") ;;
    u) abc2svgurl=$OPTARG ;;
    j) abc2svgscripts=$OPTARG ;;
    s) sspref=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || { echo "# Unrecognized argument: $1"; usage; }

abc_source "$src"
[ -n "$outfile" ] || outfile=$SRC_DIR/$SRC_NAME.html
make_tmpdir
# Process includes and put the correct modification date in headers and footers
abc_flatten "$SRC" "$TMPD/s/$SRC"
version=$(abc2svg_version)

{
  printf '%s\n' \
    '<!DOCTYPE html>' \
    '<html>' \
    '<head>' \
    '<meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>' \
    "<meta name=\"generator\" content=\"${version}\"/>" \
    "<!-- CreationDate: $(date) -->"
  for script in $abc2svgscripts
  do
    printf '<script type="text/javascript" src="%s/%s"></script>\n' "$abc2svgurl" "$script"
  done
  # <script type="text/javascript">
  #   window.no_scroll = true ;  // de-activate auto-scrolling when playing the music
  # </script>
if [ $final -eq 1 ]
then
  cat << 'ENDOFSTYLE'
<style type="text/css">
	@media print {
		body { margin:0; padding:0; border:0;}
		.nop {display:none;}
	}
	@page {size:8.27in 11.69in; margin:0;}
	svg {display:block;}
	.nop {display: none;}
	* {cursor: pointer;}  /* for iPad onclick */
</style>
ENDOFSTYLE
else
  cat << 'ENDOFSTYLE'
<style type="text/css">
	@media print {
		body { margin:0; padding:0; border:0;}
		.nop {display:none;}
	}
	@page {size:8.27in 11.69in; margin:0;}
	svg {display:block;}
	.nop {line-height: 2.5ex;}
	* {cursor: pointer;}  /* for iPad onclick */
</style>
ENDOFSTYLE
fi
  printf '<title>%s</title>\n' "$SRC_NAME"
  printf '%s\n' '</head>' '<body>' '<script type="text/vnd.abc" class="abc">'
  if [ "$sspref" != "%" ]
  then
    printf '%%%%ss-pref %s\n' "$sspref"
  fi
  cat "$TMPD/s/$SRC"
  printf '%s\n' '</script>' '</body>' '</html>'
} > "$TMPD/out.html"
cp "$TMPD/out.html" "$outfile"
if [ $debug -eq 1 ]
then
  cp "${TMPD}/s/${SRC}" "${SRC_NAME}_flatten.abc"
fi


