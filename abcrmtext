#!/bin/sh
##################################################################################
#
# Removes the text blocks (%%begintext ... %%endtext) of an ABC file to avoid
# perturbation in some conversions (for instance with abc2xml).
#
#   abcrmtext [<abc_file>...]
#
# Reads the given files, or standard input, and writes on standard output.
#
# Frédéric Boulanger                     frederic.softdev@gmail.com
#
##################################################################################
case ${1:-} in
  -h|--help)
    echo "# Usage: abcrmtext [<abc_file>...]"
    echo "#        Filters out the %%begintext/%%endtext blocks"
    echo "#        from the files or standard input to standard output."
    exit 0
    ;;
esac
exec awk '
  /^%%begintext/ { intext = 1; next }
  /^%%endtext/   { intext = 0; next }
  !intext
' "$@"
