##################################################################################
#
# A makefile to generate dynamic HTML, static HTML, PDF, MusicXML and MIDI files
# from ABC sources, using abc2svg and the abc2svgstuff scripts (which must be in
# the PATH, see install.sh).
#
# Copy or link this file as "Makefile" in a directory of ABC files, or use
#   make -f Makefile.abc2svg
#
# The dependencies on included files (at any depth) are computed by
# abcflatten -M and kept in the $(DEPDIR) directory.
#
# Frédéric Boulanger                     frederic.softdev@gmail.com
#
##################################################################################

####
## You may use $(wildcard *.abc) for everything below
## These settings are the one I use when preparing scores for several parts
## The ABCSCORE files are in the form NameOfThePiece.abc
## The ABCHTML files are in the form NameOfThePiece_partA.abc and look just the same
## as NameOfThePiece.abc, but the MIDI settings are set for working on part A
## The ABCMIDI files are generally the same as the ABCHTML files
####
ABCFILES := $(wildcard *.abc)
# Files that should be rendered as PDF, static HTML and MusicXML (no "_" in their name)
ABCSCORE := $(foreach f,$(ABCFILES),$(if $(findstring _,$(f)),,$(f)))
# Files that should be rendered as HTML pages
ABCHTML  := $(ABCFILES)
# Files that should be rendered as MIDI files
ABCMIDI  := $(ABCFILES)

# Name of the directory for exporting to MusicXML
XMLDIR   = musicxml
# Name of the directory for exporting to MIDI
MIDIDIR  = midi
# Name of the directory for the dependency files
DEPDIR   = .deps

# PDF files to be generated
PDF      = $(ABCSCORE:.abc=.pdf)
# HTML files to be generated (with dynamic interpretation of the abc source)
HTML     = $(ABCHTML:.abc=.html)
# HTML files to be generated (with static rendering of the abc source)
HTMLSTAT = $(ABCSCORE:.abc=_s.html)
# MusicXML exports (one file per tune in $(XMLDIR), a stamp file records the export)
XML      = $(ABCSCORE:%.abc=$(XMLDIR)/.%.stamp)
# MIDI exports (one file per tune in $(MIDIDIR), a stamp file records the export)
MIDI     = $(ABCMIDI:%.abc=$(MIDIDIR)/.%.stamp)

# abc2svg scripts to include in the header of the dynamic HTML pages
ABC2SVGSCRIPTS = abcweb-1.js snd-1.js follow-1.js
# Base URL of the abc2svg scripts. When empty, abc2svgweb uses $ABC2SVG_JSURL,
# or the scripts published by the author of abc2svg (http://moinejf.free.fr/js).
# For a local installation, use for instance ABC2SVGURL = ../abc2svg
ABC2SVGURL     ?=

# Commands
ABCFLATTEN   = abcflatten
ABC2SVGPDF   = abc2svgpdf
ABC2SVGWEB   = abc2svgweb
ABC2SVGHTML  = ABC2SVG_NO_REFRESH=1 abc2svghtml
ABC2SVGXML   = abc2svgxml
ABC2SVGMIDI  = abc2svgmidi

.PHONY: default all pdf html htmlstat midi xml clean clobber

default: pdf html midi

all: pdf html htmlstat midi xml

pdf : $(PDF)

html : $(HTML)

htmlstat : $(HTMLSTAT)

midi : $(MIDI)

xml : $(XML)

clean :
	rm -f $(PDF) $(HTML) $(HTMLSTAT)
	rm -rf $(DEPDIR)

clobber : clean
	rm -rf $(XMLDIR) $(MIDIDIR)

# Dependencies between the abc source files, computed by abcflatten.
# The dependency file itself depends on the included files, so that it is
# updated when an include is added to an included file.
$(DEPDIR)/%.d: %.abc
	@mkdir -p $(DEPDIR)
	@$(ABCFLATTEN) -M '$*.pdf $*.html $*_s.html $(XMLDIR)/.$*.stamp $(MIDIDIR)/.$*.stamp $@' $< > $@.tmp
	@mv $@.tmp $@

ifeq ($(filter clean clobber,$(MAKECMDGOALS)),)
-include $(ABCFILES:%.abc=$(DEPDIR)/%.d)
endif

# Make PDFs
%.pdf: %.abc
	@echo "$< --> $@"
	@$(ABC2SVGPDF) $<

# Make HTML with JS rendering
%.html: %.abc
	@echo "$< --> $@"
	@$(ABC2SVGWEB) $< -o $@ $(if $(ABC2SVGURL),-u '$(ABC2SVGURL)') -j '$(ABC2SVGSCRIPTS)'

# Make static HTML
%_s.html: %.abc
	@echo "$< --> $@"
	@$(ABC2SVGHTML) $< $@

# Export to MusicXML
$(XMLDIR)/.%.stamp: %.abc
	@echo "$< --> $(XMLDIR)/$*_*.musicxml"
	@mkdir -p $(XMLDIR)
	@$(ABC2SVGXML) $< -o $(XMLDIR)/$*
	@touch $@

# Export to MIDI
$(MIDIDIR)/.%.stamp: %.abc
	@echo "$< --> $(MIDIDIR)/$*_*.mid"
	@mkdir -p $(MIDIDIR)
	@$(ABC2SVGMIDI) $< $(MIDIDIR)/$*
	@touch $@
